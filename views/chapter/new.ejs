<!DOCTYPE html>
<html lang="pt-br">
<%- include("../includes/head") %>

  <body>
    <%- include("../includes/header") %>
      <main class="mainPrincipal mainNewChapter">

        <h1 class="titleNewChapter">
          <%= title %>
        </h1>

        <form action="/story/<%= story.directory %>/chapter/new" method="POST">

          <label for="title">Title</label>
          <input type="text" id="title" name="title" placeholder="Title">

          <label for="initialNotes">Initial notes</label>
          <textarea id="initialNotes" name="initialNotes" placeholder="Initial notes" rows="5" cols="40"></textarea>

          <label for="content">Content</label>
          <textarea id="content" name="content" placeholder="Content" rows="10" cols="50" class="textareaChapter"></textarea>

          <label for="finalNotes">Final notes</label>
          <textarea id="finalNotes" name="finalNotes" placeholder="Final notes" rows="5" cols="40"></textarea>

          <button type="submit" class="btnAdd">Add</button>
          <a href="/mystories/<%= story.directory %>/chapters"><button type="button"
              class="btnCancel">Cancel</button></a>

        </form>

      </main>
      <%- include("../includes/footer") %>
        <%- include("../includes/scripts") %>

          <script type="text/javascript">



          </script>

  </body>

</html>