<!DOCTYPE html>
<html lang="pt-br">
<%- include("../includes/head") %>

  <body>
    <%- include("../includes/header") %>
      <main class="mainPrincipal mainEditChapter">

        <h1 class="titleEditChapter">
          <%= title %>
        </h1>

        <form action="/story/<%= story.directory %>/chapter/<%= chapter.id %>/edit?_method=PUT" method="POST">

          <label for="title">Title</label>
          <input type="text" id="title" name="title" placeholder="Title" value="<%= chapter.title %>">

          <label for="initialNotes">Initial notes</label>
          <textarea id="initialNotes" name="initialNotes" placeholder="Initial notes" rows="5" cols="40"><%= chapter.initialNotes %></textarea>

          <label for="content">Content</label>
          <textarea id="content" name="content" placeholder="Content" rows="10" cols="50" class="textareaChapter"><%= chapter.content %></textarea>

          <label for="finalNotes">Final notes</label>
          <textarea id="finalNotes" name="finalNotes" placeholder="Final notes" rows="5" cols="40"><%= chapter.finalNotes %></textarea>

          <button type="submit" class="btnSave">Save</button>
          <a href="/mystories/<%= story.directory %>/chapters"><button type="button"
              class="btnCancel">Cancel</button></a>

        </form>

      </main>
      <%- include("../includes/footer") %>
        <%- include("../includes/scripts") %>

          <script type="text/javascript">



          </script>

  </body>

</html>