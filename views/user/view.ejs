<!DOCTYPE html>
<html lang="pt-br">
<%- include("../includes/head") %>

  <body>
    <%- include("../includes/header") %>
      <main class="mainPrincipal mainUser">

        <h1 class="titleUser">
          <%= user.username %>
        </h1>

        <% if(user.name !==null && user.name !=="" ) { %>
          <h2>
            <%= user.name %>
          </h2>
          <% } %>

            <!-- <%= user.avatar %> -->

            <!-- <img src=""> -->

            <% if(user.description !==null && user.description !=="" ) { %>
              <p>
                <%= user.description %>
              </p>
              <% } %>

      </main>
      <%- include("../includes/footer") %>
        <%- include("../includes/scripts") %>
  </body>

</html>