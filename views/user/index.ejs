<!DOCTYPE html>
<html lang="pt-br">
<%- include("../includes/head") %>

  <body>
    <%- include("../includes/header") %>
      <main class="mainPrincipal mainIndexUsers">

        <h1 class="titleIndexUsers">
          <%= title %>
        </h1>

        <table class="tableData">
          <% users.forEach(user=> { %>
            <tr>
              <td>
                <%= user.username %>
              </td>
              <td>
                <% if (typeof authUser !=="undefined" ) { %>

                  <a href="/user/<%= user.username %>"><button type="button" class="btnView">View</button></a>

                  <% } else if (typeof authAdmin !=="undefined" ) { %>

                    <a href="/admin/user/<%= user.username %>"><button type="button" class="btnView">View</button></a>
                    <a href="/admin/user/edit/<%= user.id %>"><button type="button" class="btnEdit">Edit</button></a>
                    <form action="/admin/user/delete/<%= user.id %>?_method=DELETE" method="POST">
                      <button type="submit" class="btnDelete">Delete</button>
                    </form>

                    <% } %>
              </td>
            </tr>
            <% }); %>
        </table>

      </main>
      <%- include("../includes/footer") %>
        <%- include("../includes/scripts") %>
  </body>

</html>