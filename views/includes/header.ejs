<header class="headerPrincipal">
  <nav class="conteudoTopo">
    <a class="logoTopo" href="/">Fiction Archive</a>
    <ul>

      <% if (typeof authUser==="undefined" && typeof authAdmin==="undefined" ) { %>

        <li><a href="/">Home</a></li>
        <li><a href="/register">Register</a></li>
        <li><a href="/login">Login</a></li>

        <% } else if (typeof authUser !=="undefined" ) { %>

          <li><a href="/user/<%= authUser.username %>">@<%= authUser.username %></a></li>
          <li><a href="/home">Home</a></li>
          <li><a href="/stories">Stories</a></li>
          <li><a href="/users">Users</a></li>
          <li><a href="/logout">Logout</a></li>

          <% } else if (typeof authAdmin !=="undefined" ) { %>

            <li><a href="/user/<%= authAdmin.username %>">@<%= authAdmin.username %></a></li>
            <li><a href="/admin/home">Home</a></li>
            <li><a href="/admin/logout">Logout</a></li>

            <% } %>

    </ul>
  </nav>
</header>